name: lab01-host-validation

# INACTIVE TEMPLATE - not loaded by GitHub (outside .github/workflows). Stage 3: root-requiring host
# validation (aa-status, systemd-analyze security, stop-gate acceptance, firewall state).
# Root-level evidence can NOT be gathered by the unprivileged stage-1 runner, so this needs a
# separate, root-owned, read-only wrapper that does not exist yet (every run fails closed) and a
# dedicated security review. Even a pass here is evidence, not a claim of host security.
on:
  workflow_dispatch:

permissions: {}

concurrency:
  group: lab01-host-access
  cancel-in-progress: false

jobs:
  gate:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      actions: read
    env:
      ENV_ATTESTED: ${{ vars.LAB01_ENV_VERIFIED_BY_FOUNDER }}
      ACTIVATED: ${{ vars.LAB01_HOST_VALIDATION_ACTIVATED }}
      ACTOR: ${{ github.actor }}
      OWNER: ${{ github.repository_owner }}
      REF: ${{ github.ref }}
    steps:
      - name: Fail closed
        run: |
          set -euo pipefail
          [[ "$ACTIVATED" == "true" ]] || { echo "::error::host validation is not activated"; exit 1; }
          [[ "$ENV_ATTESTED" == "true" ]] || { echo "::error::Environment protection not attested"; exit 1; }
          [[ "$ACTOR" == "$OWNER" ]] || { echo "::error::owner only"; exit 1; }
          [[ "$REF" == "refs/heads/main" ]] || { echo "::error::main only"; exit 1; }
      - name: Check out reviewed ref
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.11"
      - name: Install policy-check dependency
        run: python -m pip install "PyYAML==6.0.2"
      - name: Pipeline security policy check
        run: python scripts/pipeline_security_check.py
      - name: Control-file integrity manifest (tamper-evidence, not a boundary)
        run: python scripts/pipeline_integrity.py check
      - name: Verify lab01-host-validation Environment enforces approval
        env:
          GH_TOKEN: ${{ github.token }}
        run: python scripts/verify_lab01_environment.py lab01-host-validation

  host_validate:
    needs: gate
    runs-on: [self-hosted, linux, x64, gvai-lab01-hostval]
    timeout-minutes: 15
    environment: lab01-host-validation
    permissions: {}
    steps:
      - name: Run root-owned read-only host validator (never prints secrets)
        run: |
          set -euo pipefail
          umask 077
          /usr/local/libexec/gvai-ci/hostval-wrapper --output "$RUNNER_TEMP/lab01-hostval.json"
      - name: Upload evidence
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: lab01-hostval-evidence
          path: ${{ runner.temp }}/lab01-hostval.json
          retention-days: 14
          if-no-files-found: error
