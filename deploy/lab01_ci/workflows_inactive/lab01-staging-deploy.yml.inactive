name: lab01-staging-deploy

# INACTIVE TEMPLATE - lives outside .github/workflows on purpose so GitHub never loads it.
# Do NOT copy it into .github/workflows until the founder has completed the activation checklist in
# docs/lab01_secure_deployment_pipeline_v1.md ("Activating stage 2"), including a separate
# security review of the root-owned stage wrapper, which does not exist yet (so every run fails closed).
#
# Scope when activated: file STAGING only (deploy/stop_gate/lab01_stage.py plan|apply|verify).
# It never starts/enables services, never creates keys, never touches STOP-authority paths.
on:
  workflow_dispatch:
    inputs:
      sha:
        description: "Full 40-char commit SHA to stage (must be reachable from the allowed branch)"
        required: true
        type: string
      confirm:
        description: "Type STAGE <first 7 chars of sha> to confirm"
        required: true
        type: string

permissions: {}

concurrency:
  group: lab01-host-access
  cancel-in-progress: false

jobs:
  gate:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      actions: read
    env:
      ENV_ATTESTED: ${{ vars.LAB01_ENV_VERIFIED_BY_FOUNDER }}
      ACTIVATED: ${{ vars.LAB01_STAGING_ACTIVATED }}
      INPUT_SHA: ${{ inputs.sha }}
      INPUT_CONFIRM: ${{ inputs.confirm }}
      ACTOR: ${{ github.actor }}
      OWNER: ${{ github.repository_owner }}
      REF: ${{ github.ref }}
    steps:
      - name: Fail closed
        run: |
          set -euo pipefail
          [[ "$ACTIVATED" == "true" ]] || { echo "::error::stage 2 is not activated"; exit 1; }
          [[ "$ENV_ATTESTED" == "true" ]] || { echo "::error::Environment protection not attested"; exit 1; }
          [[ "$ACTOR" == "$OWNER" ]] || { echo "::error::owner only"; exit 1; }
          [[ "$REF" == "refs/heads/main" ]] || { echo "::error::main only"; exit 1; }
          [[ "$INPUT_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "::error::sha must be 40 hex"; exit 1; }
          [[ "$INPUT_CONFIRM" == "STAGE ${INPUT_SHA:0:7}" ]] || { echo "::error::confirmation mismatch"; exit 1; }
      - name: Check out reviewed ref
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.11"
      - name: Install policy-check dependency
        run: python -m pip install "PyYAML==6.0.2"
      - name: Pipeline security policy check
        run: python scripts/pipeline_security_check.py
      - name: Control-file integrity manifest (tamper-evidence, not a boundary)
        run: python scripts/pipeline_integrity.py check
      - name: Verify lab01-staging Environment enforces approval
        env:
          GH_TOKEN: ${{ github.token }}
        run: python scripts/verify_lab01_environment.py lab01-staging

  stage:
    needs: gate
    runs-on: [self-hosted, linux, x64, gvai-lab01-deploy]
    timeout-minutes: 15
    environment: lab01-staging
    permissions: {}
    env:
      INPUT_SHA: ${{ inputs.sha }}
    steps:
      - name: Plan (dry run, no changes)
        run: /usr/local/libexec/gvai-ci/stage-wrapper plan "$INPUT_SHA"
      - name: Apply file staging (reversible, backed up)
        run: /usr/local/libexec/gvai-ci/stage-wrapper apply "$INPUT_SHA"
      - name: Verify staged files
        run: /usr/local/libexec/gvai-ci/stage-wrapper verify "$INPUT_SHA"
