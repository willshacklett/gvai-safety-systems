name: lab01-rollback

# INACTIVE TEMPLATE - not loaded by GitHub (outside .github/workflows). See lab01-staging-deploy
# for the activation rules. Scope when activated: lab01_stage.py rollback + backup-verify only.
# Never stops/starts services, never deletes users, never touches STOP-authority paths.
on:
  workflow_dispatch:
    inputs:
      confirm:
        description: "Type ROLLBACK to confirm"
        required: true
        type: string

permissions: {}

concurrency:
  group: lab01-host-access
  cancel-in-progress: false

jobs:
  gate:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      actions: read
    env:
      ENV_ATTESTED: ${{ vars.LAB01_ENV_VERIFIED_BY_FOUNDER }}
      ACTIVATED: ${{ vars.LAB01_ROLLBACK_ACTIVATED }}
      INPUT_CONFIRM: ${{ inputs.confirm }}
      ACTOR: ${{ github.actor }}
      OWNER: ${{ github.repository_owner }}
      REF: ${{ github.ref }}
    steps:
      - name: Fail closed
        run: |
          set -euo pipefail
          [[ "$ACTIVATED" == "true" ]] || { echo "::error::rollback workflow is not activated"; exit 1; }
          [[ "$ENV_ATTESTED" == "true" ]] || { echo "::error::Environment protection not attested"; exit 1; }
          [[ "$ACTOR" == "$OWNER" ]] || { echo "::error::owner only"; exit 1; }
          [[ "$REF" == "refs/heads/main" ]] || { echo "::error::main only"; exit 1; }
          [[ "$INPUT_CONFIRM" == "ROLLBACK" ]] || { echo "::error::confirmation mismatch"; exit 1; }
      - name: Check out reviewed ref
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.11"
      - name: Install policy-check dependency
        run: python -m pip install "PyYAML==6.0.2"
      - name: Pipeline security policy check
        run: python scripts/pipeline_security_check.py
      - name: Control-file integrity manifest (tamper-evidence, not a boundary)
        run: python scripts/pipeline_integrity.py check
      - name: Verify lab01-rollback Environment enforces approval
        env:
          GH_TOKEN: ${{ github.token }}
        run: python scripts/verify_lab01_environment.py lab01-rollback

  rollback:
    needs: gate
    runs-on: [self-hosted, linux, x64, gvai-lab01-deploy]
    timeout-minutes: 15
    environment: lab01-rollback
    permissions: {}
    steps:
      - name: Rollback staged files (hash-checked, keeps backups)
        run: /usr/local/libexec/gvai-ci/stage-wrapper rollback
      - name: Verify backups intact
        run: /usr/local/libexec/gvai-ci/stage-wrapper backup-verify
