[Unit]
Description=GVAI Lab-01 CI runner (read-only validation; unprivileged; NOT the STOP authority)
Documentation=https://github.com/willshacklett/gvai-safety-systems/blob/main/docs/lab01_secure_deployment_pipeline_v1.md
After=network-online.target
Wants=network-online.target
# Deliberately no Requires/Wants/BindsTo/PartOf on any gvai-* workload or STOP-authority unit.

[Service]
Type=simple
User=gvai-ci
Group=gvai-ci
SupplementaryGroups=
WorkingDirectory=/var/lib/gvai-ci/runner
ExecStart=/var/lib/gvai-ci/runner/run.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
ReadWritePaths=/var/lib/gvai-ci
# Belt and braces: even a permission mistake cannot expose STOP authority or a container runtime.
InaccessiblePaths=/etc/gvai-stop-gate /var/lib/gvai-stop-gate /etc/gvai-backend /etc/gvai-runtime /etc/gvai-operator /var/lib/gvai-operator /etc/gvai-ingress /var/run/docker.sock /run/docker.sock /root /home
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
TasksMax=256
MemoryMax=1G
LimitNOFILE=4096
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/gvai-ci/tmp
Environment=RUNNER_ALLOW_RUNASROOT=0

[Install]
WantedBy=multi-user.target
