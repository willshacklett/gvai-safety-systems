[Unit]
Description=GVAI protected backend (executes only with gate permits; holds downstream credential)
Requires=gvai-protected-backend.socket
After=gvai-protected-backend.socket
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=gvai-backend
Group=gvai-backend
WorkingDirectory=/opt/gvai/current
LoadCredential=downstream:/etc/gvai-backend/downstream.cred
ExecStart=/opt/gvai/venv/bin/python -m gvai.external_gate_service backend --config /etc/gvai-backend/backend.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=control-group
InaccessiblePaths=/etc/gvai-stop-gate /var/lib/gvai-stop-gate /etc/gvai-runtime /etc/gvai-operator /etc/gvai-ingress /var/lib/gvai-operator
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
UMask=0077
TasksMax=32
MemoryMax=256M
LimitNOFILE=128
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
StandardOutput=null
StandardError=journal
