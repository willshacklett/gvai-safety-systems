abi <abi/4.0>,

# Review-only candidate. See docs/ubuntu_bwrap_apparmor.md before loading.
profile gvai-bwrap /usr/bin/bwrap flags=(enforce) {
  userns,
  capability sys_admin,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  capability setpcap,
  capability net_admin,
  capability sys_ptrace,
  network netlink raw,

  # These operations are needed for Bubblewrap's two pivot_root operations.
  # DAC and namespace capabilities still apply; this is not a host root grant.
  mount,
  remount,
  umount,
  pivot_root,

  / r,
  /usr/ r,
  /usr/** mr,
  /{,usr/}lib{,32,64}/** mr,
  /etc/ld.so.cache r,
  /etc/ld.so.preload r,
  /proc/ r,
  /proc/sys/kernel/overflow{u,g}id r,
  /proc/sys/user/max_user_namespaces r,
  /proc/{self,[0-9]*}/ r,
  /proc/{self,[0-9]*}/{stat,status,mountinfo} r,
  /proc/{self,[0-9]*}/attr/current r,
  /proc/{self,[0-9]*}/net/route r,
  /proc/net/route r,
  /proc/{self,[0-9]*}/ns/* r,
  /proc/{self,[0-9]*}/fd/ r,
  /proc/{self,[0-9]*}/fd/* rw,
  /proc/{self,[0-9]*}/{uid_map,gid_map,setgroups} rw,
  /dev/ r,
  /dev/{null,zero,full,random,urandom,tty} rw,

  /opt/gvai-safety-systems/gvai/os_sandbox_worker.py r,
  /var/lib/gvai-sandbox/input/ r,
  /var/lib/gvai-sandbox/input/** r,
  owner /tmp/gv-os-sandbox-*/ r,
  owner /tmp/gv-os-sandbox-*/** rw,

  # Setup paths before the final root pivot; inaccessible to the worker.
  /tmp/ rw,
  /tmp/{newroot,oldroot}/ rw,
  /tmp/newroot/** rw,
  /newroot/ rw,
  /newroot/** rw,
  /oldroot/ r,
  /oldroot/** r,
  /work/ rw,
  /work/** rw,
  /tmp/** rw,
  /input/ r,
  /input/** r,
  /safety/ r,
  /safety/** r,
  /runner.py r,

  signal (send, receive) peer=gvai-bwrap,
  signal (send, receive) peer=gvai-bwrap//&gvai-worker,
  signal (receive) peer=unconfined,
  ptrace (read, readby) peer=gvai-bwrap,
  ptrace (readby) peer=unconfined,

  # Stacking, not replacement: preserves confinement under no_new_privs.
  /usr/bin/python3.12 rPx -> &gvai-worker,
}

profile gvai-worker flags=(enforce) {
  # The intersection with gvai-bwrap removes all launcher setup authority.
  audit deny capability,
  audit deny userns,
  audit deny network,
  audit deny mount,
  audit deny remount,
  audit deny umount,
  audit deny pivot_root,
  audit deny ptrace (read, trace, tracedby),
  ptrace (readby) peer=unconfined,
  audit deny /proc/** w,
  audit deny /sys/** w,
  audit deny /safety/** w,

  /usr/bin/python3.12 mr,
  /usr/lib/** mr,
  /usr/lib64/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/ld.so.cache r,
  /etc/ld.so.preload r,
  /dev/{null,zero,full,random,urandom} rw,
  /proc/{self,[0-9]*}/{status,uid_map,gid_map,mountinfo} r,
  /proc/{self,[0-9]*}/attr/current r,
  /proc/{self,[0-9]*}/ns/* r,
  /proc/{self,[0-9]*}/fd/ r,
  /proc/{self,[0-9]*}/fd/* r,
  /proc/net/route r,
  /proc/{self,[0-9]*}/net/route r,
  /runner.py r,
  /input/ r,
  /input/** r,
  /safety/ r,
  /safety/** r,
  /work/ rw,
  /work/** rw,
  /tmp/ rw,
  /tmp/** rw,

  signal (receive) peer=unconfined,
  signal (receive) peer=gvai-bwrap,
}
